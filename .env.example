# General
LABLENS_ENV=production
LABLENS_SECRET_KEY=generate-a-secure-random-key-here

# Database
# Use a PostgreSQL URL for Render, e.g., postgresql://user:password@hostname/dbname
LABLENS_DATABASE_URL=sqlite+aiosqlite:///./lablens.db

# Security
LABLENS_CORS_ORIGINS=*

# Anthropic (Optional for LLM features)
LABLENS_LLM_PROVIDER=mock
LABLENS_ANTHROPIC_API_KEY=your-anthropic-api-key-here
